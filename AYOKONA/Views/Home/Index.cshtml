@{
    ViewData["Title"] = "Home Page";
}

<div class="main-container">
    <div class="title-container">
        <h1 class="title">PUPQC Gym Reservation</h1>
    </div>

    <div class="circle-container">
        <img src="~/Images/MainLogo.png" alt="Circle Image" class="circle-img" />
    </div>

    <div class="button-container">
        <a class="user-button" asp-controller="Home" asp-action="StudentLogin">Student</a>
        <a class="user-button" asp-controller="Admin" asp-action="AdminLogin">Admin</a>
    </div>
</div>

@section Scripts {
    <script>
        // Button hover animation
        document.querySelectorAll('.user-button').forEach(button => {
            button.addEventListener('mouseenter', function () {
                this.style.transform = 'translateY(-3px)';
            });

            button.addEventListener('mouseleave', function () {
                this.style.transform = 'translateY(0)';
            });
        });
    </script>
}

<style>
    body {
        font-family: 'Montserrat', Arial, sans-serif;
        background-color: #f5f3f0;
        background-image: url('/Images/Index.jpg');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center center;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    .main-container {
        min-height: calc(100vh - 120px); /* Adjust 120px to match your header+footer height */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        box-sizing: border-box;
    }

    .title-container {
        background-color: #970c10;
        color: white;
        padding: 20px 40px;
        border-radius: 10px;
        margin-bottom: 40px;
        text-align: center;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

        .title-container .title {
            color: white;
            font-size: 48px;
            font-weight: bold;
            margin: 0;
            letter-spacing: 1px;
            font-family: 'Montserrat', Arial, sans-serif;
        }

    .circle-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 40px;
    }

    .circle-img {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        object-fit: contain;
        display: block;
        background: #970c10;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .button-container {
        display: flex;
        gap: 100px;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
    }

    .user-button {
        background-color: #970c10;
        color: white;
        border: none;
        padding: 18px 40px;
        font-size: 28px;
        font-weight: bold;
        border-radius: 15px;
        cursor: pointer;
        transition: all 0.3s ease;
        min-width: 180px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-family: 'Montserrat', Arial, sans-serif;
        margin-bottom: 10px;
    }

        .user-button:hover {
            background-color: #6B1F15;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(139, 44, 27, 0.3);
        }

        .user-button:active {
            transform: translateY(0);
        }

    @@media (max-width: 900px) {
        .main-container

    {
        padding: 24px 4vw;
    }

    .button-container {
        gap: 24px;
    }

    .title-container .title {
        font-size: 32px;
    }

    .circle-img {
        width: 120px;
        height: 120px;
    }

    }

    @@media (max-width: 600px) {
        .main-container

    {
        min-height: calc(100vh - 80px);
        padding: 12px 2vw;
    }

    .title-container .title {
        font-size: 22px;
    }

    .circle-img {
        width: 90px;
        height: 90px;
    }

    .button-container {
        flex-direction: column;
        gap: 16px;
    }

    .user-button {
        font-size: 18px;
        padding: 12px 20px;
        min-width: 120px;
    }

    }
</style>