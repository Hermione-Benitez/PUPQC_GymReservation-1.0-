@{
    ViewData["Title"] = "AdminDashboard";
    Layout = "Admin_Layout";
}

    <style>
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 1px;
            background-color: #d9d9d9;
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .calendar-header-cell, .calendar-cell {
            padding: 0.75rem 0.5rem;
            text-align: center;
            background-color: white;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #d9d9d9;
            color: #970c10;
        }

            .calendar-cell:not(.reserved-slot) {
                font-weight: bold;
            }

        .calendar-header-cell {
            background-color: #f3f4f6;
            font-weight: 600;
            color: #970c10;
        }

        .reserved-slot {
            background-color: #970c10;
            color: white;
            font-weight: 500;
        }

        .status-approved {
            background-color: #00bf63;
            color: white;
        }

        .status-pending {
            background-color: #ffb000;
            color: white;
        }

        .status-rejected,
        .status-denied {
            background-color: dimgrey;
            color: white;
        }

        .reservation-item-bg {
            background-color: #ffb000;
            border-color: #ffb000;
        }

        .month-nav-arrow {
            font-size: 1.5rem;
            line-height: 1;
            color: #970c10;
        }

        @@media (max-width: 640px) {
            .calendar-grid {
                overflow-x: auto;
            }

                .calendar-grid > div {
                    min-width: 80px;
                }
        }

        /* Status badge styles */
        .status-badge {
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            color: white;
        }

        /* Reservation item and details styles */
        .reservation-item {
            background: #970c10;
            border: 2px solid #970c10;
            border-radius: 8px;
            margin-bottom: 15px;
            overflow: hidden;
            transition: all 0.3s ease;
            cursor: pointer; /* To toggle details */
        }

            .reservation-item:hover {
                border-color: #970c10;
                box-shadow: 0 4px 12px rgba(151, 12, 16, 0.2);
            }

        .request-header {
            background-color: #970c10;
            color: white;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .request-info {
            display: flex;
            gap: 30px;
            font-size: 14px;
            color: white;
            font-weight: bold;
        }

        .empty-state {
            text-align: center;
            color: white;
            padding: 50px;
            font-style: italic;
        }

        /* Media queries */
        @@media (max-width: 900px) {
            .request-info {
                flex-direction: column;
                gap: 5px;
            }
        }
    </style>

<div class="w-full p-6 flex-grow flex flex-col">
    <h1 class="text-3xl font-bold mb-4 text-center" style="color: #970c10;">Admin Dashboard</h1>

    <div class="mx-auto" style="width: 75%;">
        <h2 class="text-2xl font-semibold mt-4 mb-2" style="color: #970c10;">Reservation Requests</h2>
        <div class="bg-white p-8 rounded-lg shadow-lg flex flex-col">
            <div id="reservationRequestsContainer" class="space-y-3 flex-grow">
                <div class="empty-state">Loading reservation requests...</div>
            </div>
            <div class="text-center mt-4">
                <a href="/Admin/AdminManage" id="viewMoreRequestsLink" class="underline text-sm font-bold" style="color: #970c10;">View More Requests</a>
            </div>
        </div>
    </div>

    <div class="mx-auto" style="width: 75%;">
        <h2 class="text-2xl font-semibold mt-6 mb-2" style="color: #970c10;">Gym Availability</h2>
        <div class="bg-white p-8 rounded-lg shadow-lg">
            <div class="flex items-center justify-between mb-4">
                <button id="prevMonthBtn" class="hover:text-blue-800 transition-colors text-lg font-semibold">
                    <span class="month-nav-arrow">&#10094;</span>
                    <span id="prevMonthText" style="color: #ffb000;"></span>
                </button>
                <span id="currentMonthYear" class="text-2xl font-bold" style="color: #970c10;"></span>
                <button id="nextMonthBtn" class="hover:text-blue-800 transition-colors text-lg font-semibold">
                    <span id="nextMonthText" style="color: #ffb000;"></span>
                    <span class="month-nav-arrow">&#10095;</span>
                </button>
            </div>

            <div id="calendarGrid" class="calendar-grid shadow-md">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const allRequestsData = JSON.parse('@Html.Raw(ViewData["ReservationRequests"])');

        document.addEventListener('DOMContentLoaded', () => {
            renderReservationRequests();
        });

        function showReservationDetails(request) {
            const requestDate = new Date(request.Date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
            const formatTime = (timeSpanString) => {
                const parts = timeSpanString.split(':');
                const hours = parseInt(parts[0], 10);
                const minutes = parseInt(parts[1], 10);
                const dateForTime = new Date();
                dateForTime.setHours(hours);
                dateForTime.setMinutes(minutes);
                dateForTime.setSeconds(0);
                return dateForTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
            };

            const startTimeFormatted = request.PeriodStartTime ? formatTime(request.PeriodStartTime) : 'N/A';
            const endTimeFormatted = request.PeriodEndTime ? formatTime(request.PeriodEndTime) : 'N/A';
            const timeSlotName = (request.PeriodId === 6) ? 'Whole Day' : `${startTimeFormatted} - ${endTimeFormatted}`;

            Swal.fire({
                title: 'Reservation Details',
                html: `
                    <div style="text-align: left; color: #333;">
                        <p><strong>Date:</strong> ${requestDate}</p>
                        <p><strong>Time:</strong> ${timeSlotName}</p>
                        <p><strong>User:</strong> ${request.UserName || 'N/A'} (${request.UserSection || 'N/A'})</p>
                        <p><strong>Category:</strong> ${request.GroupCategory || 'N/A'}</p>
                        <p><strong>Group Name:</strong> ${request.GroupName || 'N/A'}</p>
                        <p><strong>Professor In-Charge:</strong> ${request.ProfInCharge || 'N/A'}</p>
                        <p><strong>Purpose:</strong> ${request.Purpose || 'N/A'}</p>
                        <p><strong>Status:</strong> <span style="color: ${getStatusColor(request.Status)}">${request.Status.toUpperCase()}</span></p>
                    </div>
                `,
                confirmButtonColor: '#970c10',
                confirmButtonText: 'Close'
            });
        }

        function getStatusColor(status) {
            switch(status.toLowerCase()) {
                case 'pending': return '#ffb000';
                case 'approved': return '#00bf63';
                case 'denied':
                case 'rejected': return 'dimgrey';
                default: return '#333';
            }
        }

        function renderReservationRequests() {
            const container = document.getElementById('reservationRequestsContainer');
            container.innerHTML = '';

            if (!allRequestsData || allRequestsData.length === 0) {
                container.innerHTML = '<div class="empty-state">No reservation requests found.</div>';
                return;
            }

            // Sort by CreatedAt, descending for latest at top
            allRequestsData.sort((a, b) => new Date(b.CreatedAt) - new Date(a.CreatedAt));

            allRequestsData.forEach(request => {
                const requestDiv = document.createElement('div');
                requestDiv.className = 'reservation-item';

                let statusClass = '';
                if (request.Status === 'pending') {
                    statusClass = 'status-pending';
                } else if (request.Status === 'approved') {
                    statusClass = 'status-approved';
                } else if (request.Status === 'denied' || request.Status === 'rejected') {
                    statusClass = 'status-denied';
                }

                const requestDate = new Date(request.Date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

                const formatTime = (timeSpanString) => {
                    const parts = timeSpanString.split(':');
                    const hours = parseInt(parts[0], 10);
                    const minutes = parseInt(parts[1], 10);
                    const dateForTime = new Date();
                    dateForTime.setHours(hours);
                    dateForTime.setMinutes(minutes);
                    dateForTime.setSeconds(0);
                    return dateForTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                };

                const startTimeFormatted = request.PeriodStartTime ? formatTime(request.PeriodStartTime) : 'N/A';
                const endTimeFormatted = request.PeriodEndTime ? formatTime(request.PeriodEndTime) : 'N/A';
                const timeSlotName = (request.PeriodId === 6) ? 'Whole Day' : `${startTimeFormatted} - ${endTimeFormatted}`;

                requestDiv.innerHTML = `
                    <div class="request-header">
                        <div class="request-info">
                            <span>Date: ${requestDate}</span>
                            <span>Time: ${timeSlotName}</span>
                        </div>
                        <div class="status-badge ${statusClass}">${request.Status.toUpperCase()}</div>
                    </div>
                `;

                container.appendChild(requestDiv);

                // Show details in popup on click
                requestDiv.addEventListener('click', () => showReservationDetails(request));
            });
        }

        // Gym Availability Calendar Script (Keep existing)
        let today = new Date();
        let currentMonth = today.getMonth(); // 0-indexed (0 for January, 5 for June)
        let currentYear = today.getFullYear();

        const timeSlots = [
            "7:30 AM - 10:30 AM",
            "10:30 AM - 1:30 PM",
            "1:30 PM - 4:30 PM",
            "4:30 PM - 7:30 PM",
            "7:30 PM - 8:30 PM"
        ];

        async function renderCalendar(month, year) {
            const calendarGrid = document.getElementById('calendarGrid');
            calendarGrid.innerHTML = '';
            document.getElementById('currentMonthYear').textContent = new Date(year, month).toLocaleString('en-US', { month: 'long', year: 'numeric' });
            document.getElementById('currentMonthYear').style.color = '#970c10';

            document.getElementById('prevMonthText').textContent = new Date(year, month - 1).toLocaleString('en-US', { month: 'long' });
            document.getElementById('nextMonthText').textContent = new Date(year, month + 1).toLocaleString('en-US', { month: 'long' });
            document.getElementById('prevMonthText').style.color = '#ffb000';
            document.getElementById('nextMonthText').style.color = '#ffb000';

            const headerRow = `
                <div class="calendar-header-cell">Days</div>
                ${timeSlots.map(slot => `<div class="calendar-header-cell">${slot}</div>`).join('')}
            `;
            calendarGrid.innerHTML += headerRow;

            let reservedSlotsData = [];
            try {
                const response = await fetch(`http://localhost:5000/api/gymAvailability/${year}/${month + 1}`);

                if (!response.ok) {
                    console.error(`Gym Availability API responded with status: ${response.status} - ${response.statusText}`);
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                reservedSlotsData = await response.json();
            } catch (error) {
                console.error('Error fetching gym availability:', error);
                const errorCell = document.createElement('div');
                errorCell.className = 'calendar-cell';
                errorCell.style.gridColumn = '1 / span 6';
                errorCell.style.color = 'red';
                errorCell.textContent = 'Error loading availability. Please check console for details.';
                calendarGrid.appendChild(errorCell);
            }

            const daysInMonth = new Date(year, month + 1, 0).getDate();

            for (let day = 1; day <= daysInMonth; day++) {
                calendarGrid.innerHTML += `<div class="calendar-cell">${day}</div>`;

                timeSlots.forEach(slot => {
                    const dateToCheck = new Date(year, month, day);
                    const formattedDateForComparison = dateToCheck.toISOString().slice(0, 10);

                    const isReserved = reservedSlotsData.some(res =>
                        new Date(res.reservationDate).toISOString().slice(0, 10) === formattedDateForComparison &&
                        res.timeSlot === slot
                    );

                    calendarGrid.innerHTML += `<div class="calendar-cell ${isReserved ? 'reserved-slot' : ''}"></div>`;
                });
            }
        }

        document.getElementById('prevMonthBtn').addEventListener('click', () => {
            currentMonth--;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            }
            renderCalendar(currentMonth, currentYear);
        });

        document.getElementById('nextMonthBtn').addEventListener('click', () => {
            currentMonth++;
            if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            renderCalendar(currentMonth, currentYear);
        });

        window.onload = () => {
            renderReservationRequests(); // Render requests on load
            renderCalendar(currentMonth, currentYear); // Render calendar on load
        };
    </script>
}