@{
    ViewData["Title"] = "StudentDashboard";
    Layout = "~/Views/Shared/Students_Layout.cshtml";
}

@section Styles {
    <style>
        .calendar-grid {
            display: grid;
            gap: 1px;
            background-color: #d9d9d9;
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .calendar-header-cell, .calendar-cell {
            padding: 0.75rem 0.5rem;
            text-align: center;
            background-color: white;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #d9d9d9;
            color: #970c10;
            cursor: default; /* Make cells not directly clickable unless specific action needed */
        }

        .calendar-header-cell {
            background-color: #f3f4f6;
            font-weight: 600;
            color: #970c10;
        }

        .reserved-slot {
            background-color: #970c10;
            color: white;
            font-weight: 500;
        }

        .status-approved {
            background-color: #ffb000;
            color: #333;
        }

        .status-pending {
            background-color: #ffb000;
            color: white;
        }

        .status-rejected {
            background-color: dimgrey;
            color: white;
        }

        .reservation-item-bg {
            background-color: #ffb000;
            border-color: #ffb000;
        }

        .month-nav-arrow {
            font-size: 1.5rem;
            line-height: 1;
            color: #970c10;
        }

        @@media (max-width: 640px) {
            .calendar-grid {
                overflow-x: auto;
            }

                .calendar-grid > div {
                    min-width: 80px;
                }
        }
    </style>
}

<div class="w-full p-6 flex-grow flex flex-col">
    <h1 class="text-3xl font-bold mb-4 text-center" style="color: #970c10;">Dashboard</h1>

    <div class="mx-auto" style="width: 75%;">
        <h2 class="text-2xl font-semibold mt-4 mb-2" style="color: #970c10;">Your Reservations</h2>
        <div class="bg-white p-8 rounded-lg shadow-lg flex flex-col">
            <div id="userReservationsContainer" class="space-y-3 flex-grow">
                <p class="text-gray-500 text-center py-4" style="color: #970c10;">You have no active reservations.</p>
            </div>
            <div class="text-center mt-4">
                <a href="/Users/UserReservation" id="viewMyReservationsLink" class="underline text-sm font-bold" style="color: #970c10;">View More Reservations</a>
            </div>
        </div>
    </div>

    <div class="mx-auto" style="width: 75%;">
        <h2 id="GymAvailability" class="text-2xl font-semibold mt-6 mb-2" style="color: #970c10;">Gym Availability</h2>
        <div class="bg-white p-8 rounded-lg shadow-lg">
            <div class="flex items-center justify-between mb-4">
                <button id="prevMonthBtn" class="hover:text-blue-800 transition-colors text-lg font-semibold">
                    <span class="month-nav-arrow">&#10094;</span>
                    <span id="prevMonthText" style="color: #ffb000;"></span>
                </button>
                <span id="currentMonthYear" class="text-2xl font-bold" style="color: #970c10;"></span>
                <button id="nextMonthBtn" class="hover:text-blue-800 transition-colors text-lg font-semibold">
                    <span id="nextMonthText" style="color: #ffb000;"></span>
                    <span class="month-nav-arrow">&#10095;</span>
                </button>
            </div>

            <div id="calendarGrid" class="calendar-grid shadow-md">
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Get the UserId from ViewData (passed by the C# controller)
        const currentUserId = '@ViewData["UserId"]';
        const userReservationsData = JSON.parse('@Html.Raw(ViewData["UserReservations"])');

        // Initialize current month and year to the current date
        let today = new Date();
        let currentMonth = today.getMonth();
        let currentYear = today.getFullYear();

        // Get data from ViewData
        const allPeriods = JSON.parse('@Html.Raw(ViewData["Periods"])');
        const fullyBookedSlots = JSON.parse('@Html.Raw(ViewData["FullyBookedSlots"])');
        const wholeDayBlockedDates = JSON.parse('@Html.Raw(ViewData["WholeDayBlockedDates"])').map(dateString => new Date(dateString).toLocaleDateString());
        const approvedCalendarSlots = JSON.parse('@Html.Raw(ViewData["ApprovedCalendarSlots"])');

        // Initialize current month and year from ViewData if available
        const initialMonth = @(ViewData["CurrentMonth"] ?? "null");
        const initialYear = @(ViewData["CurrentYear"] ?? "null");

        if (initialMonth !== null && initialYear !== null) {
            currentMonth = initialMonth - 1; // Month is 0-indexed in JavaScript
            currentYear = initialYear;
        }

        document.getElementById('viewMyReservationsLink').addEventListener('click', (e) => {
            e.preventDefault();
            window.location.href = '/Users/UserReservation';
        });

        async function renderUserReservations() {
            const container = document.getElementById('userReservationsContainer');
            container.innerHTML = ''; // Clear loading message

            if (!userReservationsData || userReservationsData.length === 0) {
                container.innerHTML = '<p class="text-gray-500 text-center py-4" style="color: #970c10;">You have no active reservations.</p>';
                return;
            }

            const recentReservations = userReservationsData.slice(0, 3); // Show only recent 3

            recentReservations.forEach(reservation => {
                const reservationDiv = document.createElement('div');
                let statusClass = '';
                if (reservation.Status === 'approved') {
                    statusClass = 'status-approved';
                } else if (reservation.Status === 'pending') {
                    statusClass = 'status-pending';
                } else if (reservation.Status === 'rejected') {
                    statusClass = 'status-rejected';
                }

                const reservationDate = new Date(reservation.Date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                
                // Format TimeSpan strings to readable time format (e.g., 9:00 AM - 10:00 AM)
                const formatTime = (timeSpanString) => {
                    // timeSpanString is typically "HH:mm:ss.ms" or "HH:mm:ss"
                    const parts = timeSpanString.split(':');
                    const hours = parseInt(parts[0], 10);
                    const minutes = parseInt(parts[1], 10);

                    const dateForTime = new Date(); // Use a dummy date to leverage Date object's time formatting
                    dateForTime.setHours(hours);
                    dateForTime.setMinutes(minutes);
                    dateForTime.setSeconds(0);

                    return dateForTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                };

                // Access PeriodStartTime and PeriodEndTime directly from the reservation object
                const startTimeFormatted = reservation.PeriodStartTime ? formatTime(reservation.PeriodStartTime) : 'N/A';
                const endTimeFormatted = reservation.PeriodEndTime ? formatTime(reservation.PeriodEndTime) : 'N/A';
                const timeSlotName = (reservation.PeriodId === 6) ? 'Whole Day' : `${startTimeFormatted} - ${endTimeFormatted}`;

                // Access GroupName directly from the reservation object
                const groupName = reservation.GroupName || 'N/A';
                const purpose = reservation.Purpose || 'N/A';
                const profInCharge = reservation.ProfInCharge || 'N/A';
                const status = reservation.Status || 'N/A';

                reservationDiv.className = `flex flex-row items-center justify-between p-4 rounded-lg shadow-sm reservation-item-bg cursor-pointer`;
                reservationDiv.innerHTML = `
                    <div class="flex flex-row space-x-4 items-center">
                        <span class="text-lg text-white"><strong style="font-weight: bold;">Date:</strong> ${reservationDate}</span>
                        <span class="text-lg text-white"><strong style="font-weight: bold;">Time:</strong> ${timeSlotName}</span>
                    </div>
                    <span class="px-3 py-1 text-sm font-semibold rounded-full ${statusClass}">Status: ${status}</span>
                `;
                container.appendChild(reservationDiv);

                // Add click event listener to show details
                reservationDiv.addEventListener('click', () => {
                    Swal.fire({
                        title: 'Reservation Details',
                        html: `
                            <p><strong>Date:</strong> ${reservationDate}</p>
                            <p><strong>Time:</strong> ${timeSlotName}</p>
                            <p><strong>Group:</strong> ${groupName}</p>
                            <p><strong>Purpose:</strong> ${purpose}</p>
                            <p><strong>Professor In-Charge:</strong> ${profInCharge}</p>
                            <p><strong>Status:</strong> ${status}</p>
                        `,
                        icon: 'info',
                        confirmButtonText: 'OK'
                    });
                });
            });
        }

        // Call the render function on page load
        renderUserReservations();

        function getDaysInMonth(month, year) {
            return new Date(year, month + 1, 0).getDate();
        }

        function formatTime(timeSpanString) {
            if (!timeSpanString) return 'N/A';
            const parts = timeSpanString.split(':');
            const hours = parseInt(parts[0], 10);
            const minutes = parseInt(parts[1], 10);
            const dateForTime = new Date();
            dateForTime.setHours(hours);
            dateForTime.setMinutes(minutes);
            dateForTime.setSeconds(0);
            return dateForTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
        }

        async function renderCalendar(month, year) {
            const calendarGrid = document.getElementById('calendarGrid');
            calendarGrid.innerHTML = ''; // Clear existing content

            const daysInMonth = getDaysInMonth(month, year);

            document.getElementById('currentMonthYear').textContent = new Date(year, month).toLocaleString('en-US', { month: 'long', year: 'numeric' });
            document.getElementById('currentMonthYear').style.color = '#970c10';

            // Update month navigation text and links
            const prevMonthDate = new Date(year, month - 1);
            document.getElementById('prevMonthText').textContent = prevMonthDate.toLocaleString('en-US', { month: 'long' });
            document.getElementById('prevMonthText').style.color = '#ffb000';
            document.getElementById('prevMonthBtn').onclick = () => navigateMonth(month - 1, year);

            const nextMonthDate = new Date(year, month + 1);
            document.getElementById('nextMonthText').textContent = nextMonthDate.toLocaleString('en-US', { month: 'long' });
            document.getElementById('nextMonthText').style.color = '#ffb000';
            document.getElementById('nextMonthBtn').onclick = () => navigateMonth(month + 1, year);

            // Set grid columns dynamically based on periods + 1 for the 'Days' column
            calendarGrid.style.gridTemplateColumns = `repeat(${allPeriods.length + 1}, 1fr)`;

            // Create header row
            const daysHeaderCell = document.createElement('div');
            daysHeaderCell.className = 'calendar-header-cell';
            daysHeaderCell.textContent = 'Days';
            calendarGrid.appendChild(daysHeaderCell);

            allPeriods.forEach(period => {
                const headerCell = document.createElement('div');
                headerCell.className = 'calendar-header-cell';
                headerCell.textContent = `${formatTime(period.StartTime)} - ${formatTime(period.EndTime)}`;
                calendarGrid.appendChild(headerCell);
            });

            // Populate calendar days
            for (let day = 1; day <= daysInMonth; day++) {
                const date = new Date(year, month, day);
                // Ensure consistent date formatting for all comparisons
                const formattedDateForComparison = `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${day.toString().padStart(2, '0')}`;

                // Day cell
                const dayCell = document.createElement('div');
                dayCell.className = 'calendar-cell';
                dayCell.textContent = day;
                calendarGrid.appendChild(dayCell);

                allPeriods.forEach(period => {
                    const slotCell = document.createElement('div');
                    slotCell.className = 'calendar-cell';

                    let isSlotReserved = false; // Combined flag for any reserved status

                    // Check for Whole Day Blocked Dates (from Reservations/Requests PeriodId 6)
                    if (wholeDayBlockedDates.some(blockedDateString => {
                        const bd = new Date(blockedDateString);
                        return bd.getFullYear() === date.getFullYear() && bd.getMonth() === date.getMonth() && bd.getDate() === date.getDate();
                    })) {
                        isSlotReserved = true;
                    }

                    // Check for Fully Booked Slots (3+ reservations)
                    if (!isSlotReserved) { // Only check if not already reserved by whole day
                        for (const bookedSlot of fullyBookedSlots) {
                            const bsDate = new Date(bookedSlot.date);
                            if (bsDate.getFullYear() === date.getFullYear() && bsDate.getMonth() === date.getMonth() && bsDate.getDate() === date.getDate() && bookedSlot.periodId === period.PeriodId) {
                                isSlotReserved = true;
                                break;
                            }
                        }
                    }

                    // Check for Approved Calendar Slots (any approved reservation)
                    if (!isSlotReserved) { // Only check if not already reserved by previous conditions
                        for (const approvedSlot of approvedCalendarSlots) {
                            const asDate = new Date(approvedSlot.date);
                            if (asDate.getFullYear() === date.getFullYear() && asDate.getMonth() === date.getMonth() && asDate.getDate() === date.getDate() && approvedSlot.periodId === period.PeriodId) {
                                isSlotReserved = true;
                                break;
                            }
                        }
                    }

                    if (isSlotReserved) {
                        slotCell.classList.add('reserved-slot');
                    }
                    
                    calendarGrid.appendChild(slotCell);
                });
            }
        }

        function navigateMonth(month, year) {
            const newDate = new Date(year, month);
            // Update URL parameters and reload page to fetch new data from server
            window.location.href = `/Users/StudentDashboard?month=${newDate.getMonth() + 1}&year=${newDate.getFullYear()}`;
        }

        // Initial render on page load
        renderCalendar(currentMonth, currentYear);
    </script>
}