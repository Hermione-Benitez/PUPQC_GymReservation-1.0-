@model AYOKONA.Models.RegistrationModelView

@{
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f5f5f5;
            min-height: 100vh;
            display: flex;
        }

        .left-panel {
            background-color: white;
            padding: 40px 30px;
            width: 100%;
            max-width: 450px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 10px;
        }

        .section-title {
            color: #8B0000;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .main-title {
            font-size: 28px;
            font-weight: 700;
            color: #333;
            margin-bottom: 20px;
        }

        .welcome {
            font-weight: 600;
            margin-bottom: 5px;
        }

        .instruction {
            margin-bottom: 25px;
            font-size: 14px;
            color: #555;
        }

        form {
            width: 100%;
        }

        .form-group {
            margin-bottom: 18px;
        }

            .form-group label {
                font-weight: 600;
                margin-bottom: 5px;
                display: block;
                color: #8B0000;
            }

            .form-group input {
                width: 100%;
                padding: 10px 12px;
                border: 1.5px solid #ccc;
                border-radius: 6px;
                font-size: 14px;
            }

                .form-group input:focus {
                    border-color: #8B0000;
                    outline: none;
                }

        .input-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .input-group button {
                padding: 8px 10px;
                background-color: #8B0000;
                color: #fff;
                border: none;
                border-radius: 5px;
                font-size: 13px;
                cursor: pointer;
            }

        .register-button {
            width: 100%;
            background-color: #8B0000;
            color: white;
            border: none;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.3s;
            margin-top: 20px;
        }

            .register-button:hover {
                background-color: #6a0000;
            }

        .text-danger {
            color: red;
            font-size: 13px;
        }

        .right-panel {
            flex: 1;
            background-color: #8B0000;
            display: none;
        }

        @@media (min-width: 768px) {
            .right-panel

        {
            display: block;
        }

        body {
            flex-direction: row;
        }

        }
    </style>
</head>
<body>

    <div class="left-panel">
        <img src="~/Images/MainLogo.png" alt="Logo" class="logo" />
        <div class="section-title">STUDENTS</div>
        <div class="main-title">Gym Reservation</div>
        <div class="welcome">Welcome to PUPQC Gym Reservation Portal</div>
        <div class="instruction">Fill out your credentials below to register.</div>

        <form asp-action="Register">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StudentNumber"></label>
                <input asp-for="StudentNumber" />
                <span asp-validation-for="StudentNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Section"></label>
                <input asp-for="Section" />
                <span asp-validation-for="Section" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PasswordHash"></label>
                <div class="input-group">
                    <input asp-for="PasswordHash" id="PasswordHash" type="password" />
                    <button type="button" onclick="togglePassword('PasswordHash', this)">Show</button>
                </div>
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" />
                    <button type="button" onclick="togglePassword('ConfirmPassword', this)">Show</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="register-button">Register</button>
        </form>
    </div>

    <div class="right-panel">
        <!-- Background panel, visible only on wider screens -->
    </div>

    <script>
        function togglePassword(fieldId, btn) {
            const input = document.getElementById(fieldId);
            if (input.type === "password") {
                input.type = "text";
                btn.textContent = "Hide";
            } else {
                input.type = "password";
                btn.textContent = "Show";
            }
        }
    </script>

</body>
</html>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
